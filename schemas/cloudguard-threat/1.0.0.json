{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cloudguard-threat/1.0.0",
  "title": "CloudGuard Threat Record",
  "type": "object",
  "required": ["threat_id", "version", "name", "change_type", "severity", "source"],
  "properties": {
    "threat_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "name": {"type": "string", "minLength": 1},
    "change_type": {"type": "string"},
    "severity": {"type": "string", "enum": ["INFORMATIONAL", "LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "source": {
      "type": "object",
      "required": ["source_id", "name", "trust"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "trust": {"type": "string", "enum": ["AUTHORITATIVE", "VERIFIED_CTI", "INTERNAL_CONFIRMED", "UNTRUSTED_DISCOVERY"]},
        "reference": {"type": ["string", "null"]},
        "content_digest": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "techniques": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "observables": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "affected_assets": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "first_seen": {"type": ["string", "null"]},
    "last_seen": {"type": ["string", "null"]},
    "confidence": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
